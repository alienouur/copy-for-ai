{
  "manifest_version": 3,
  "name": "Copy for AI – AI Homework Helper: Solve & Explain Any Question",
  "short_name": "Copy for AI",
  "version": "1.6.0",
  "description": "AI homework helper: solves and explains the questions on any page, quiz, PDF or screenshot in a side panel. 5 free answers a day.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copy for AI – Solve this page"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "clipboardWrite",
    "offscreen",
    "notifications",
    "sidePanel"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://copyforai.onrender.com/*"
    ]
  },
  "commands": {
    "solve-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Solve the questions on the current page"
    },
    "copy-page": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy current page as Markdown"
    }
  }
}
