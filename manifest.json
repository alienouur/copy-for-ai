{
  "manifest_version": 3,
  "name": "Copy for AI – Solve any question on the page",
  "short_name": "Copy for AI",
  "version": "1.1.0",
  "description": "Reads the open page (or a screenshot of it) and gives you the answer – with or without explanation. Also copies pages as Markdown.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy for AI – Solve this page"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "clipboardWrite",
    "offscreen",
    "notifications"
  ],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "copy-page": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Copy current page as Markdown"
    }
  }
}
